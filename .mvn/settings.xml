<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven settings for CI. Local builds read the Polarion artifacts from ~/.m2 and do not need this file. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <activeProfiles>
        <activeProfile>itc-polarion</activeProfile>
    </activeProfiles>

    <profiles>
        <profile>
            <id>itc-polarion</id>
            <!-- Maven asks the repositories in this order. Central comes first, so Nexus only gets requests for the Polarion artifacts. -->
            <repositories>
                <repository>
                    <id>central</id>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>itc-polarion-3rdparty</id>
                    <url>${env.NEXUS_URL}</url>
                    <releases>
                        <enabled>true</enabled>
                        <updatePolicy>never</updatePolicy>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <servers>
        <server>
            <id>itc-polarion-3rdparty</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
    </servers>
</settings>
