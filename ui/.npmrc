# npm 12 announces every script run ("npm notice run ...") at notice level, on stderr.
# frontend-maven-plugin labels everything on stderr as [ERROR], so a clean Maven build printed a
# dozen fake errors. Dropping to warn keeps the real warnings and silences the notices.
# Note this also hides the install summary and the `npm audit` counts - run `npm audit` directly.
loglevel=warn

# The update check writes "New major version of npm available!" to stderr, same problem.
update-notifier=false
